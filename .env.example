# ---- server ----
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# ---- auth ----
# Comma-separated key:permission pairs. Permissions: readonly | full
# readonly -> status, cards, events.  full -> everything incl. opening doors.
API_KEYS=change-me-readonly:readonly,change-me-full:full

# ---- controllers ----
# Either point at a JSON file (recommended)...
CONTROLLERS_FILE=./controllers.json
# ...or inline the JSON array:
# CONTROLLERS_JSON=[{"id":"front","driver":"memory","doors":[1,2]}]

# ---- timeouts (ms) ----
HARDWARE_TIMEOUT=10000
SERVER_TIMEOUT=30000

# ---- circuit breaker ----
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_ERROR_THRESHOLD=50
CIRCUIT_BREAKER_RESET_TIMEOUT=60000
CIRCUIT_BREAKER_VOLUME_THRESHOLD=5

# ---- UHPPOTE UDP (only needed for uhppote controllers) ----
# The container usually needs host networking to broadcast on the door LAN.
UHPPOTE_BIND=0.0.0.0
UHPPOTE_BROADCAST=255.255.255.255:60000
UHPPOTE_LISTEN=0.0.0.0:60001
