{
  "name": "door-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "HeatSync Labs door control service: one sensible REST API over different door controllers (UHPPOTE/UT0311 and the legacy Open Access Arduino board) behind a driver adapter layer.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "sim": "node sim/arduino-openaccess.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/type-provider-typebox": "^5.0.0",
    "@sinclair/typebox": "^0.33.0",
    "fastify": "^5.0.0",
    "opossum": "^8.0.0",
    "pino": "^9.0.0",
    "uhppoted": "^0.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@types/opossum": "^8.0.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^11.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.72.2",
    "vitest": "^2.0.0"
  }
}
